DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"
ADMIN_NAME="Academy Admin"
ADMIN_EMAIL="admin@indooracademy.in"
ADMIN_PASSWORD="choose-a-strong-password"
# COOKIE_SECURE="false"

# ---- Bookings & rentals (all optional) ----
# Online payments with Razorpay. Without these, customers only see "Pay at the academy".
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""
# Email notifications (booking confirmations, reminders, refunds).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""
# Lets the host call /api/rentals/housekeeping?key=... on a schedule (at least 16 characters).
# CRON_SECRET=""
