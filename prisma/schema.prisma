// INDOOR ACADEMY database schema.
// SQLite is used for local development. To move to PostgreSQL later, change
// `provider` below and DATABASE_URL in .env, then run `npx prisma migrate dev`.
//
// Dates that are "calendar days" (attendance, payments, DOB) are stored as
// 'YYYY-MM-DD' strings in India time so they never shift across timezones.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("COACH") // ADMIN | COACH
  createdAt    DateTime @default(now())
}

model Branch {
  id        String    @id @default(cuid())
  name      String    @unique
  address   String?
  mapsUrl   String? // Google Maps share link, e.g. https://maps.app.goo.gl/...
  // JSON list of facilities: [{ "key": "INDOOR_NETS", "detail": "3 nets" }, { "key": "CUSTOM", "label": "AC hall" }]
  facilities String?
  photos    BranchPhoto[]
  createdAt DateTime  @default(now())
  students  Student[]
  batches   Batch[]
  coaches   Coach[]
  notices   Notice[]
}

model Coach {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  email          String?
  specialization String? // Batting, Bowling, Fielding, Fitness, Head coach...
  active         Boolean  @default(true)
  branchId       String?
  branch         Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  batches        Batch[]
  // Public profile, shown on the coach's page of the public home page. All optional.
  bio            String?
  coachingSince  Int? // year the coach started coaching, e.g. 2012
  experience     String? // experience and qualifications, one per line
  achievements   String? // trophies and awards, one per line; a line may start with a year: "2019 - Best coach"
  instagramUrl   String?
  facebookUrl    String?
  youtubeUrl     String?
  photo          CoachPhoto?
  // Set when a photo is saved; used as the image's cache-busting version. Null = no photo.
  photoUpdatedAt DateTime?
  createdAt      DateTime @default(now())
}

// Coach profile photo (public, unlike student photos). Small JPEG, resized in the browser.
model CoachPhoto {
  coachId   String   @id
  coach     Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model Batch {
  id         String       @id @default(cuid())
  name       String
  ageGroup   String // U-10, U-12, ... Open
  days       String // comma separated: "Mon,Wed,Fri"
  startTime  String // "16:00"
  endTime    String // "17:30"
  venue      String? // "Net 01", "Main Pitch"
  monthlyFee Int          @default(0) // rupees
  active     Boolean      @default(true)
  branchId   String
  branch     Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  coachId    String?
  coach      Coach?       @relation(fields: [coachId], references: [id], onDelete: SetNull)
  students   Student[]
  attendance Attendance[]
  notices    Notice[]
  drills     Drill[]
  createdAt  DateTime     @default(now())
}

// Practice drill / homework set by a coach, for a whole batch or chosen students.
model Drill {
  id           String            @id @default(cuid())
  title        String
  instructions String
  videoUrl     String?
  category     String            @default("OTHER") // BATTING | BOWLING | FIELDING | FITNESS | OTHER
  dueOn        String? // YYYY-MM-DD
  batchId      String? // set = whole batch; null = the students in DrillStudent
  batch        Batch?            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  students     DrillStudent[]
  completions  DrillCompletion[]
  createdById  String?
  createdBy    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([batchId])
}

model DrillStudent {
  drillId   String
  drill     Drill   @relation(fields: [drillId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([drillId, studentId])
  @@index([studentId])
}

// Coach's comment on a student's monthly progress report.
model ProgressComment {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  month     String // YYYY-MM
  comment   String
  author    String?
  updatedAt DateTime @updatedAt

  @@unique([studentId, month])
}

// A student (or parent) marked the drill as done in the parent app.
model DrillCompletion {
  id        String   @id @default(cuid())
  drillId   String
  drill     Drill    @relation(fields: [drillId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  note      String?
  doneAt    DateTime @default(now())

  @@unique([drillId, studentId])
}

// Photo of a branch's facilities (nets, ground…), shown in the parent app. Resized in the browser before upload.
model BranchPhoto {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  caption   String?
  createdAt DateTime @default(now())

  @@index([branchId])
}

// Announcement shown in the parent app (and shareable on WhatsApp).
model Notice {
  id          String   @id @default(cuid())
  title       String
  body        String
  audience    String   @default("ALL") // ALL | BRANCH | BATCH
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  batchId     String?
  batch       Batch?   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  pinned      Boolean  @default(false)
  expiresOn   String? // YYYY-MM-DD; parents stop seeing it after this day
  createdById String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

model Student {
  id            String       @id @default(cuid())
  name          String
  dob           String? // YYYY-MM-DD
  ageGroup      String
  playingRole   String? // Batter, Bowler, All-rounder, WK-Batter
  guardianName  String?
  guardianPhone String
  // guardianPhone as digits with country code (919876543210); links the student to a parent login.
  guardianPhoneKey String?
  status        String       @default("ACTIVE") // ACTIVE | REVIEW | INACTIVE
  joinedOn      String // YYYY-MM-DD
  notes         String?
  // Health & emergency (visible to staff and the student's own family)
  bloodGroup     String? // A+, A-, B+, B-, AB+, AB-, O+, O-
  emergencyName  String?
  emergencyPhone String?
  medicalNotes   String? // allergies, asthma, injuries...
  branchId      String
  branch        Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  batchId       String?
  batch         Batch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  attendance    Attendance[]
  payments      FeePayment[]
  assessments   Assessment[]
  reminders     Reminder[]
  matchStats    PlayerMatchStat[]
  squads        TournamentSquad[]
  drillTargets  DrillStudent[]
  drillsDone    DrillCompletion[]
  progressNotes ProgressComment[]
  photo         StudentPhoto?
  // Set when a profile photo is saved; used as the image's cache-busting version. Null = no photo.
  photoUpdatedAt DateTime?
  createdAt     DateTime     @default(now())

  @@index([branchId])
  @@index([batchId])
  @@index([guardianPhoneKey])
}

// Student profile photo, stored in the database so it moves with the data (small JPEG, resized in the browser).
model StudentPhoto {
  studentId String   @id
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  updatedBy String? // staff name, or "Parent / student"
  updatedAt DateTime @updatedAt
}

// Parent / student app login. One per guardian phone; it shows every student with that phone.
model FamilyLogin {
  id             String    @id @default(cuid())
  phoneKey       String    @unique // same format as Student.guardianPhoneKey
  pinHash        String
  active         Boolean   @default(true)
  // Bumped on PIN reset or disable so older sessions stop working.
  sessionVersion Int       @default(1)
  lastLoginAt    DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())
}

// A WhatsApp message opened for a parent (fee reminder or absence notice).
// Logged when the button is clicked; WhatsApp does not tell us whether it was actually sent.
model Reminder {
  id        String   @id @default(cuid())
  kind      String // FEE | ABSENT
  ref       String // YYYY-MM for FEE, YYYY-MM-DD for ABSENT
  sentBy    String?
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([studentId, kind, ref])
  @@index([kind, ref])
}

// Simple key/value app settings (academy name, WhatsApp message templates).
model Setting {
  key   String @id
  value String
}

model Attendance {
  id        String   @id @default(cuid())
  date      String // YYYY-MM-DD
  status    String // PRESENT | ABSENT | LATE
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batchId   String?
  batch     Batch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  markedBy  String?
  createdAt DateTime @default(now())

  @@unique([studentId, date])
  @@index([date])
}

model FeePayment {
  id        String   @id @default(cuid())
  amount    Int // rupees
  forMonth  String // YYYY-MM the fee is for
  paidOn    String // YYYY-MM-DD
  method    String   @default("CASH") // CASH | UPI | CARD | BANK
  reference String?
  // e.g. IA/2026-27/0001; numbered per Indian financial year (Apr-Mar), never reused.
  receiptNo  String? @unique
  recordedBy String?
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([forMonth])
  @@index([paidOn])
}

model Assessment {
  id        String   @id @default(cuid())
  date      String // YYYY-MM-DD
  batting   Int // 1-10
  bowling   Int // 1-10
  fielding  Int // 1-10
  fitness   Int // 1-10
  notes     String?
  coachName String?
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([studentId])
}

model Tournament {
  id        String   @id @default(cuid())
  name      String
  startDate String // YYYY-MM-DD
  endDate   String?
  venue     String?
  ageGroup  String?
  status    String   @default("UPCOMING") // UPCOMING | ONGOING | COMPLETED
  result    String?
  squad     TournamentSquad[]
  matches   Match[]
  createdAt DateTime @default(now())
}

// Students selected for a tournament.
model TournamentSquad {
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  role         String     @default("PLAYER") // CAPTAIN | VICE_CAPTAIN | WICKET_KEEPER | PLAYER | RESERVE
  addedAt      DateTime   @default(now())

  @@id([tournamentId, studentId])
  @@index([studentId])
}

// A match the academy played (practice, friendly, tournament or league).
model Match {
  id            String            @id @default(cuid())
  date          String // YYYY-MM-DD
  opponent      String
  venue         String?
  matchType     String            @default("FRIENDLY") // PRACTICE | FRIENDLY | TOURNAMENT | LEAGUE
  overs         Int? // overs per side
  result        String? // WON | LOST | DRAW | TIE | NO_RESULT
  ourScore      String? // free text, e.g. "145/6 (20)"
  opponentScore String?
  notes         String?
  tournamentId  String?
  tournament    Tournament?       @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  stats         PlayerMatchStat[]
  createdBy     String?
  createdAt     DateTime          @default(now())

  @@index([date])
}

// One player's batting, bowling and fielding in one match.
model PlayerMatchStat {
  id           String  @id @default(cuid())
  matchId      String
  match        Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batted       Boolean @default(false)
  notOut       Boolean @default(false)
  runs         Int     @default(0)
  balls        Int     @default(0)
  fours        Int     @default(0)
  sixes        Int     @default(0)
  ballsBowled  Int     @default(0) // overs stored as balls: 3.4 overs = 22
  maidens      Int     @default(0)
  runsConceded Int     @default(0)
  wickets      Int     @default(0)
  catches      Int     @default(0)
  stumpings    Int     @default(0)
  runOuts      Int     @default(0)

  @@unique([matchId, studentId])
  @@index([studentId])
}
